{
  "name": "tripeseats-monorepo",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "esbuild"]
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "hostinger:build": "npx prisma generate --schema packages/database/prisma/schema.prisma && npx tsc -p packages/database/tsconfig.json && npx tsc -p apps/api/tsconfig.json",
    "hostinger:archive": "node scripts/hostinger-api-archive.mjs",
    "hostinger:deploy": "node scripts/hostinger-deploy-from-archive.mjs lightcyan-kingfisher-777374.hostingersite.com",
    "hostinger:archive:web": "powershell -ExecutionPolicy Bypass -File scripts/hostinger-web-archive.ps1",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "pnpm --filter api test && pnpm --filter web test",
    "db:generate": "pnpm --filter @tripeseats/database prisma generate",
    "db:migrate": "pnpm --filter @tripeseats/database prisma migrate dev",
    "db:migrate:deploy": "pnpm --filter @tripeseats/database prisma migrate deploy",
    "db:migrate:prod": "pnpm db:migrate:deploy",
    "db:push": "pnpm --filter @tripeseats/database prisma db push",
    "db:push:pooler": "node packages/database/scripts/push-via-pooler.mjs",
    "db:patch-slug": "pnpm --filter api db:patch-slug",
    "migrate:prefs": "pnpm --filter api exec tsx src/scripts/migrate-package-selections.ts",
    "migrate:event-types": "pnpm --filter api exec tsx src/scripts/migrate-event-service-fields.ts",
    "load:smoke": "k6 run tests/load/k6/scenarios/smoke.js",
    "load:quote-journey": "k6 run tests/load/k6/scenarios/quote-journey.js",
    "load:ramp-up": "k6 run tests/load/k6/scenarios/ramp-up.js",
    "load:all": "pnpm load:smoke && pnpm load:quote-journey && pnpm load:ramp-up"
  },
  "devDependencies": {
    "axios": "^1.18.1",
    "turbo": "^2.1.2",
    "tus-js-client": "^4.3.1",
    "typescript": "^5.6.3"
  }
}
