API_PORT=4000
# Transaction pooler (runtime). Use ?pgbouncer=true for Prisma + Supavisor; add sslmode + timeout if connections fail.
# Production: add connection_limit=6 for single-process VPS (see DEPLOYMENT.md). Dev may omit it.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=6&sslmode=require&connect_timeout=30"
# Session pooler or direct (migrations / introspection). Must differ from transaction URL per Supabase Prisma docs.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=30"
RESEND_API_KEY="re_xxx"
# From address must be a domain you've verified in Resend (or use onboarding@resend.dev for tests only).
RESEND_FROM_EMAIL="Tripeseats <onboarding@resend.dev>"
# Public lead form (`POST /api/leads`) attaches Guest, Lead, and Event to this caterer.
# Set this to YOUR caterer ID from the caterers table — the real account that should receive inquiries.
# Find it: SELECT id FROM caterers WHERE email = 'your@email.com';
LEAD_INTAKE_CATERER_ID=your-actual-caterer-id-here
BETTER_AUTH_SECRET="replace-with-a-random-32-char-minimum-secret"
# Must match the browser origin where `/api/auth` is used. With Next.js proxy, that is the web app (port 3000), not this API port.
BETTER_AUTH_URL="http://localhost:3000"
# Better Auth Infra (dash). From Better Auth dashboard → Connect your app.
BETTER_AUTH_API_KEY="ba_xxx"
# Must match how you open the site (and CORS). Same as BETTER_AUTH_URL for local dev.
WEB_ORIGIN="http://localhost:3000"
# Root domain for tenant subdomains — must match NEXT_PUBLIC_ROOT_DOMAIN on web (no protocol).
# Enables cross-subdomain auth cookies and CORS for *.caterpro.com
PUBLIC_ROOT_DOMAIN="localhost"
# Optional comma-separated extra origins (e.g. Vercel preview URL or another tunnel).
# BETTER_AUTH_TRUSTED_ORIGINS="https://your-preview.vercel.app"
# Allow all https://*.vercel.app preview deploys (recommended for staging only).
# ALLOW_VERCEL_PREVIEW_ORIGINS=true

# Platform super-admins for Vendor Calendar (comma-separated emails). Also supports user.isSuperAdmin in DB.
SUPER_ADMIN_EMAILS=""

# Sentry error monitoring (production only)
SENTRY_DSN="https://xxx@sentry.io/xxx"

# Clover Hosted Checkout
# Preferred: each caterer connects via OAuth (Settings → Connect with Clover) or pastes keys.
# Sandbox OAuth app:
CLOVER_APP_ID=""
CLOVER_APP_SECRET=""
# Must match Site URL domain; defaults to WEB_ORIGIN + /api/clover/oauth/callback
# CLOVER_OAUTH_REDIRECT_URI="https://your-domain.com/api/clover/oauth/callback"
CLOVER_API_BASE_URL="https://apisandbox.dev.clover.com"
# Optional server-wide fallback (single merchant / migration):
CLOVER_MERCHANT_ID=""
CLOVER_ECOMMERCE_PRIVATE_KEY=""
CLOVER_ECOMMERCE_PUBLIC_KEY=""
CLOVER_WEBHOOK_SECRET=""
# Optional dedicated key for encrypting per-caterer Clover secrets (defaults to BETTER_AUTH_SECRET)
# CLOVER_SECRETS_KEY=""
# Webhook URL (same for all caterers): https://YOUR_DOMAIN/api/webhooks/clover
# Redirect URLs: https://YOUR_DOMAIN/pay/success | /pay/failure | /pay/cancel

# Local load testing only — bypasses rate limiters when NODE_ENV !== production.
# Add to apps/api/.env.local (never set true in production).
# LOAD_TEST_MODE=true
# NODE_ENV=development
# BETTER_AUTH_URL=http://localhost:3000
# WEB_ORIGIN=http://localhost:3000
# PUBLIC_ROOT_DOMAIN=localhost
