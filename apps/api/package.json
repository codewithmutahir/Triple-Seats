{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --import ./src/preload.ts src/index.ts",
    "build": "pnpm --filter @tripeseats/database build && pnpm --filter @tripeseats/auth build && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:patch-slug": "tsx src/scripts/apply-caterer-slug-migration.ts",
    "lint": "echo \"No lint configured for api\"",
    "typecheck": "pnpm --filter @tripeseats/database build && pnpm --filter @tripeseats/auth build && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@better-auth/infra": "^0.2.14",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/node": "^10.63.0",
    "@sentry/profiling-node": "^10.63.0",
    "@tripeseats/auth": "workspace:*",
    "@tripeseats/database": "workspace:*",
    "better-auth": "1.7.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.2.0",
    "react": "18.3.1",
    "resend": "^4.0.1",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  }
}
