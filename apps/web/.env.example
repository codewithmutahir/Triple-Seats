# Base URL of the Express API (used by the dashboard layout to verify sessions server-side).
INTERNAL_API_URL=http://127.0.0.1:4000

# Root domain for tenant subdomains (no protocol).
# Production: caterpro.com → booking at royaltaj.caterpro.com/book
# Local dev: localhost → test at royaltaj.localhost:3000/book
NEXT_PUBLIC_ROOT_DOMAIN=localhost
