# Base URL of the Express API (proxied by Next at /api/*). Use the local API when running `pnpm dev`.
INTERNAL_API_URL=http://127.0.0.1:4000

# Do not set NODE_ENV=production here for local dev — it disables localhost in Better Auth trusted origins.

# Root domain for the web app (no protocol) — used to build `/book/[slug]` links.
# Production: tripleseat.hussaincatering.com
# Local dev: localhost → test at http://localhost:3000/book/royaltaj
NEXT_PUBLIC_ROOT_DOMAIN=localhost
