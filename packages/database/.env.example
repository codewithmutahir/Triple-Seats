# Runtime (API / Prisma queries) — Supabase transaction pooler
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrations (prisma migrate dev / db push) — must reach Postgres on port 5432
#
# Recommended: Supabase Dashboard → Project Settings → Database → Connection string
#   Mode: "Direct connection"
#   Host: db.<project-ref>.supabase.co:5432  (NOT the pooler host)
#
# If migrate fails with P1001 but the app works on VPN, your network often blocks
# pooler :5432 while allowing :6543. Either:
#   1. Fix DIRECT_URL to db.<project-ref>.supabase.co and allow 5432 on VPN, or
#   2. Dev workaround: pnpm db:push:pooler  (from repo root)
#   3. Run SQL manually: Supabase Dashboard → SQL → paste prisma/migrations/.../migration.sql
#
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres"
