generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EventStatus {
  lead
  discussion
  booked
  completed
  lost
}

enum UnitType {
  per_head
  by_tray
}

enum MessageDirection {
  inbound
  outbound
  internal
}

enum TaskStatus {
  todo
  in_progress
  blocked
  done
}

enum ReminderStatus {
  pending
  sent
  acknowledged
  paid
}

enum QuoteStatus {
  draft
  sending
  send_failed
  sent
  accepted
  declined
  archived
}

enum PaymentMethod {
  cash
  credit_card
  bank_transfer
  other
}

enum PaymentStatus {
  pending
  completed
  refunded
  failed
}

enum ItemCategory {
  appetizer
  veg_gravy
  chicken_gravy
  mutton_gravy
  rice_chicken
  rice_mutton
  breads
  side_items
  bbq
  dessert
  beverages
  equipment
  delivery
  labor
  other
}

enum TeamRole {
  owner
  admin
  manager
  sales
  ops
  viewer
  /// External vendor — vendor calendar only (no leads, settings, etc.).
  calendar_only
}

enum InviteStatus {
  pending
  accepted
  declined
  expired
}

enum QuoteUnit {
  per_head
  by_tray
  flat
  per_piece
  tiered_per_head
}

enum EventType {
  delivery
  pickup
  order_by_tray
  full_service
}

enum ServiceType {
  full_service
  order_by_tray
}

enum OrderMode {
  delivery
  pickup
}

enum CustomerType {
  b2b
  b2c
}

enum CalendarShowAs {
  busy
  free
  tentative
  oof
}

enum CalendarShareScope {
  view
  edit
}

enum VendorRecurrenceFreq {
  none
  daily
  weekly
  monthly
  yearly
}

model Caterer {
  id                     String            @id @default(cuid())
  userId                 String?           @unique
  name                   String
  slug                   String?           @unique
  email                  String            @unique
  phone                  String?
  timezone               String?           @default("UTC")
  currencyCode           String            @default("USD")
  websiteUrl             String?
  cloverMerchantId             String?
  cloverPrivateKeyEnc          String?
  cloverWebhookSecretEnc       String?
  cloverPublicKey              String?
  cloverConnectedAt            DateTime?
  /// OAuth refresh token (encrypted). Present means connected via OAuth.
  cloverRefreshTokenEnc        String?
  cloverAccessTokenExpiresAt   DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  user                   User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  guests                 Guest[]
  leads                  Lead[]
  events                 Event[]
  quotes                 Quote[]
  menuItems              MenuItem[]
  cateringPackages       CateringPackage[]
  tasks                  Task[]
  messages               Message[]
  paymentReminders       PaymentReminder[]
  payments               Payment[]
  teamMembers            TeamMember[]
  auditLogs              AuditLog[]
  vendorCalendarEntries  VendorCalendarEntry[]
  vendorCalendarAttendees VendorCalendarAttendee[]
  vendorCalendarReminderLogs VendorCalendarReminderLog[]

  @@index([cloverMerchantId])
  @@map("caterers")
}

model AuditLog {
  id         String   @id @default(cuid())
  catererId  String
  actorId    String
  actorEmail String?
  action     String
  entityType String?
  entityId   String?
  summary    String
  metadata   Json?
  createdAt  DateTime @default(now())
  caterer    Caterer  @relation(fields: [catererId], references: [id], onDelete: Cascade)

  @@index([catererId])
  @@index([catererId, createdAt])
  @@map("audit_logs")
}

model TeamMember {
  id           String       @id @default(cuid())
  catererId    String
  userId       String?
  email        String
  name         String?
  phone        String?
  jobTitle     String?
  role         TeamRole     @default(viewer)
  inviteToken  String?      @unique
  inviteStatus InviteStatus @default(pending)
  invitedBy    String
  joinedAt     DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  caterer      Caterer      @relation(fields: [catererId], references: [id], onDelete: Cascade)

  @@unique([catererId, email])
  @@index([catererId])
  @@index([inviteToken])
  @@map("team_members")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified Boolean   @default(false)
  image         String?
  /// Platform-level flag — can view all vendor calendars and manage share grants.
  isSuperAdmin  Boolean   @default(false)
  /// When true, dashboard is limited to vendor calendar only (external vendor invite accepted).
  vendorCalendarOnly Boolean @default(false)
  /// Secret token for read-only iCal/webcal subscription feed.
  vendorCalendarIcalToken String? @unique
  /// Google Calendar OAuth (encrypted refresh token).
  googleCalendarRefreshTokenEnc String?
  googleCalendarAccessTokenEnc  String?
  googleCalendarTokenExpiresAt  DateTime?
  googleCalendarId              String?   @default("primary")
  googleCalendarEmail           String?
  googleCalendarConnectedAt     DateTime?
  /// Better Auth two-factor plugin — TOTP enabled after verification.
  twoFactorEnabled Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  twoFactor     TwoFactor?
  caterer       Caterer?
  vendorCalendarEntries VendorCalendarEntry[] @relation("VendorCalendarOwner")
  calendarGrantsReceived CalendarShareGrant[] @relation("CalendarGrantGrantee")
  calendarGrantsTargeted CalendarShareGrant[] @relation("CalendarGrantTarget")
  calendarGrantsCreated  CalendarShareGrant[] @relation("CalendarGrantCreator")

  @@map("user")
}

/// Personal/ops availability blocks per user (separate from booking Event calendar).
model VendorCalendarEntry {
  id          String         @id @default(cuid())
  catererId   String
  ownerUserId String
  title       String
  notes       String?
  location    String?
  startAt     DateTime
  endAt       DateTime
  allDay      Boolean        @default(false)
  showAs      CalendarShowAs @default(busy)
  isPrivate   Boolean        @default(false)
  recurrenceFreq          VendorRecurrenceFreq @default(none)
  recurrenceInterval      Int                  @default(1)
  /// Comma-separated weekday codes for weekly recurrence (MO,TU,WE,TH,FR,SA,SU).
  recurrenceDaysOfWeek    String?
  recurrenceEndAt         DateTime?
  recurrenceCount         Int?
  /// Minutes before start to remind (stored for display; delivery via email queue later).
  reminderMinutesBefore   Int?
  /// Teams / Google Meet / Zoom link (stored URL only).
  meetingUrl              String?
  /// Optional custom hex color override (#RRGGBB).
  colorHex                String?
  /// Linked Google Calendar event (two-way sync).
  googleEventId           String?
  googleEventEtag         String?
  googleEventUpdatedAt    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  caterer     Caterer        @relation(fields: [catererId], references: [id], onDelete: Cascade)
  owner       User           @relation("VendorCalendarOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  attendees   VendorCalendarAttendee[]
  reminderLogs VendorCalendarReminderLog[]

  @@index([catererId])
  @@index([catererId, startAt, endAt])
  @@index([ownerUserId, startAt])
  @@index([ownerUserId, recurrenceFreq])
  @@index([ownerUserId, googleEventId])
  @@map("vendor_calendar_entries")
}

model VendorCalendarAttendee {
  id        String              @id @default(cuid())
  catererId String
  entryId   String
  email     String
  name      String?
  createdAt DateTime            @default(now())
  caterer   Caterer             @relation(fields: [catererId], references: [id], onDelete: Cascade)
  entry     VendorCalendarEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, email])
  @@index([catererId])
  @@index([entryId])
  @@map("vendor_calendar_attendees")
}

model VendorCalendarReminderLog {
  id                String              @id @default(cuid())
  catererId         String
  entryId           String
  occurrenceStartAt DateTime
  sentAt            DateTime            @default(now())
  caterer           Caterer             @relation(fields: [catererId], references: [id], onDelete: Cascade)
  entry             VendorCalendarEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, occurrenceStartAt])
  @@index([catererId])
  @@index([entryId])
  @@map("vendor_calendar_reminder_logs")
}

/// Super-admin grants: grantee may view (or edit) target user's vendor calendar.
model CalendarShareGrant {
  id              String             @id @default(cuid())
  granteeUserId   String
  targetUserId    String
  scope           CalendarShareScope @default(view)
  grantedByUserId String
  createdAt       DateTime           @default(now())
  grantee         User               @relation("CalendarGrantGrantee", fields: [granteeUserId], references: [id], onDelete: Cascade)
  target          User               @relation("CalendarGrantTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  grantedBy       User               @relation("CalendarGrantCreator", fields: [grantedByUserId], references: [id], onDelete: Cascade)

  @@unique([granteeUserId, targetUserId])
  @@index([granteeUserId])
  @@index([targetUserId])
  @@map("calendar_share_grants")
}

model TwoFactor {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  secret                  String
  backupCodes             String
  verified                Boolean   @default(false)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("twoFactor")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id           String    @id @default(cuid())
  accountId    String
  /// Better Auth 1.7+ identity namespace (e.g. local:credential for email/password).
  issuer       String
  providerId   String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String?
  refreshToken String?
  idToken      String?
  expiresAt    DateTime?
  password     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@index([providerId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Guest {
  id             String    @id @default(cuid())
  catererId      String
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  company        String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  caterer        Caterer   @relation(fields: [catererId], references: [id], onDelete: Cascade)
  leads          Lead[]
  eventsAsPrimaryGuest Event[] @relation("PrimaryGuestEvents")
  messages       Message[]

  @@unique([catererId, email])
  @@index([catererId])
  @@index([catererId, email])
  @@index([catererId, createdAt])
  @@index([catererId, phone])
  @@map("guests")
}

model Lead {
  id               String     @id @default(cuid())
  catererId        String
  guestId          String?
  /// Form / inquiry email; used to claim intake rows when guestId is missing or guests were removed.
  contactEmail     String?
  source           String?
  title            String
  notes            String?
  estimatedBudget  Decimal?   @db.Decimal(12, 2)
  estimatedGuests  Int?
  expectedEventAt  DateTime?
  customerType     CustomerType @default(b2c)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  caterer          Caterer    @relation(fields: [catererId], references: [id], onDelete: Cascade)
  guest            Guest?     @relation(fields: [guestId], references: [id], onDelete: SetNull)
  events           Event[]
  messages         Message[]

  @@index([catererId])
  @@index([catererId, createdAt])
  @@index([catererId, expectedEventAt])
  @@index([catererId, contactEmail])
  @@index([contactEmail])
  @@index([guestId])
  @@map("leads")
}

model Event {
  id                 String            @id @default(cuid())
  catererId          String
  leadId             String?
  primaryGuestId     String?
  title              String
  eventType          EventType         @default(full_service)
  serviceType        ServiceType       @default(full_service)
  orderMode          OrderMode         @default(delivery)
  customerType       CustomerType      @default(b2c)
  status             EventStatus       @default(lead)
  eventDate          DateTime
  eventTime          String?
  startTime          DateTime?
  endTime            DateTime?
  venueName          String?
  venueAddress       String?
  guestCountEstimate Int?
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  caterer            Caterer           @relation(fields: [catererId], references: [id], onDelete: Cascade)
  lead               Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  primaryGuest       Guest?            @relation("PrimaryGuestEvents", fields: [primaryGuestId], references: [id], onDelete: SetNull)
  quotes             Quote[]
  tasks              Task[]
  messages           Message[]
  paymentReminders   PaymentReminder[]
  menuPreferences    MenuPreference[]
  payments           Payment[]

  @@index([catererId])
  @@index([catererId, status])
  @@index([catererId, eventDate])
  @@index([catererId, status, eventDate])
  @@index([catererId, createdAt])
  @@index([createdAt])
  @@index([leadId])
  @@index([primaryGuestId])
  @@map("events")
}

model MenuPreference {
  id           String   @id @default(cuid())
  eventId      String
  packageId    String
  slotLabel    String
  selectedItem String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, slotLabel])
  @@index([eventId])
  @@map("menu_preferences")
}

model Quote {
  id          String          @id @default(cuid())
  catererId   String
  eventId     String
  status      QuoteStatus     @default(draft)
  notes       String?
  taxRate     Float           @default(0.0875)
  depositPct  Float           @default(0.5)
  dueDate     DateTime?
  totalAmount Float           @default(0)
  revision    Int             @default(0)
  packageSelections Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  caterer     Caterer         @relation(fields: [catererId], references: [id], onDelete: Cascade)
  event       Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  lineItems   QuoteLineItem[]
  reminders   PaymentReminder[]
  payments    Payment[]

  @@index([catererId])
  @@index([eventId])
  @@index([catererId, eventId])
  @@index([catererId, createdAt])
  @@map("quotes")
}

model QuoteLineItem {
  id                String            @id @default(cuid())
  quoteId           String
  menuItemId        String?
  packageId         String?
  category          ItemCategory
  name              String
  quantity          Float             @default(1)
  unitPrice         Float
  unitType          QuoteUnit
  appliedTier       Float?
  appliedTierLabel  String?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  quote             Quote             @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  menuItem          MenuItem?         @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  package           CateringPackage?  @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([packageId])
  @@map("quote_line_items")
}

model QuoteItemIdempotency {
  id              String   @id @default(cuid())
  quoteId         String
  clientRequestId String
  lineItemId      String
  createdAt       DateTime @default(now())

  @@unique([quoteId, clientRequestId])
  @@index([quoteId])
  @@map("quote_item_idempotency")
}

model CateringPackage {
  id          String                @id @default(cuid())
  catererId   String
  name        String
  description String?
  sortOrder   Int                   @default(0)
  minGuests   Int                   @default(200)
  createdAt   DateTime              @default(now())
  caterer     Caterer               @relation(fields: [catererId], references: [id], onDelete: Cascade)
  tiers       PackagePriceTier[]
  items       PackageIncludedItem[]
  kitchenQtys PackageKitchenQty[]
  lineItems   QuoteLineItem[]

  @@index([catererId])
  @@map("catering_packages")
}

model PackagePriceTier {
  id           String          @id @default(cuid())
  packageId    String
  customerType CustomerType    @default(b2c)
  minGuests    Int
  maxGuests    Int?
  pricePerHead Float
  package      CateringPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, customerType])
  @@map("package_price_tiers")
}

model PackageIncludedItem {
  id        String          @id @default(cuid())
  packageId String
  label     String
  quantity  Int             @default(1)
  sortOrder Int             @default(0)
  package   CateringPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@map("package_included_items")
}

model PackageKitchenQty {
  id        String          @id @default(cuid())
  packageId String
  guestBand Int
  category  String
  quantity  Float           @default(0)
  package   CateringPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, guestBand, category])
  @@index([packageId])
  @@map("package_kitchen_qtys")
}

model MenuItem {
  id           String       @id @default(cuid())
  catererId    String
  category     ItemCategory
  name         String
  defaultPrice Float?
  defaultUnit  QuoteUnit    @default(per_head)
  usageCount   Int          @default(0)
  isDefault    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  caterer      Caterer      @relation(fields: [catererId], references: [id], onDelete: Cascade)
  quoteLineItems QuoteLineItem[]

  @@unique([catererId, category, name])
  @@index([catererId, category])
  @@index([catererId, usageCount])
  @@map("menu_items")
}

model Task {
  id          String     @id @default(cuid())
  catererId   String
  eventId     String?
  title       String
  description String?
  status      TaskStatus @default(todo)
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  caterer     Caterer    @relation(fields: [catererId], references: [id], onDelete: Cascade)
  event       Event?     @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([catererId, status, dueAt])
  @@index([eventId])
  @@map("tasks")
}

model Message {
  id          String           @id @default(cuid())
  catererId   String
  leadId      String?
  eventId     String?
  guestId     String?
  direction   MessageDirection
  channel     String           @default("email")
  subject     String?
  body        String
  senderName  String?
  senderEmail String?
  sentAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  caterer     Caterer          @relation(fields: [catererId], references: [id], onDelete: Cascade)
  lead        Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  event       Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  guest       Guest?           @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([catererId, createdAt])
  @@index([catererId])
  @@index([leadId])
  @@index([eventId])
  @@index([guestId])
  @@map("messages")
}

model Payment {
  id                 String        @id @default(cuid())
  catererId          String
  eventId            String
  quoteId            String?
  amount             Float
  method             PaymentMethod
  status             PaymentStatus @default(completed)
  note               String?
  addedBy            String
  paymentDate        DateTime      @default(now())
  provider           String?
  checkoutSessionId  String?
  externalPaymentId  String?
  checkoutUrl        String?
  expiresAt          DateTime?
  idempotencyKey     String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  caterer            Caterer       @relation(fields: [catererId], references: [id], onDelete: Cascade)
  event              Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  quote              Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@unique([checkoutSessionId])
  @@unique([idempotencyKey])
  @@index([catererId])
  @@index([eventId])
  @@index([externalPaymentId])
  @@map("payments")
}

model PaymentReminder {
  id            String         @id @default(cuid())
  catererId     String
  eventId       String
  quoteId       String?
  status        ReminderStatus @default(pending)
  dueDate       DateTime
  amountDue     Decimal        @db.Decimal(12, 2)
  reminderDate  DateTime?
  sentAt        DateTime?
  note          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  caterer       Caterer        @relation(fields: [catererId], references: [id], onDelete: Cascade)
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  quote         Quote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@index([catererId, dueDate, status])
  @@index([eventId])
  @@index([quoteId])
  @@map("payment_reminders")
}
